# Privy app ID - required for wallet connect/auth. Get one at https://dashboard.privy.io
VITE_PRIVY_APP_ID=

# Groq API key - required for the "Ask Fellow" command bar's natural
# language understanding. Get one at https://console.groq.com/keys
# Server-side only, never exposed to the browser. Without it, the command
# bar falls back to a small set of fixed phrasings.
GROQ_API_KEY=
